#!/bin/zsh
set -euo pipefail

SITE_DIR="__SITE_DIR__"
PORT=8080
URL="http://127.0.0.1:${PORT}/"
LOG_DIR="$HOME/Library/Logs/The Living Frontier"
LOG_FILE="$LOG_DIR/server.log"
PID_FILE="$LOG_DIR/server.pid"

mkdir -p "$LOG_DIR"

if ! /usr/bin/curl --silent --fail --max-time 1 "$URL" >/dev/null 2>&1; then
  (cd /tmp && exec /usr/bin/python3 -m http.server "$PORT" --bind 127.0.0.1 --directory "$SITE_DIR") >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"
  for _ in {1..50}; do
    /usr/bin/curl --silent --fail --max-time 1 "$URL" >/dev/null 2>&1 && break
    /bin/sleep 0.1
  done
fi

if ! /usr/bin/curl --silent --fail --max-time 1 "$URL" >/dev/null 2>&1; then
  /usr/bin/osascript -e 'display alert "The Living Frontier" message "The local game server did not start. See ~/Library/Logs/The Living Frontier/server.log." as critical'
  exit 1
fi

/usr/bin/open -na "Brave Browser" --args --app="$URL" --window-size=1440,900
